---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/ui/Icon.astro";
import { PAGES, SOCIALS } from "../../config";

if (PAGES.contact?.isActive === false) {
    return Astro.redirect("/404");
}

const linkedInSocial = SOCIALS.find((s) => s.name === "LinkedIn");
const scholarSocial = SOCIALS.find((s) => s.name === "Google Scholar");
const githubSocial = SOCIALS.find((s) => s.name === "Github");
const orcidSocial = SOCIALS.find((s) => s.name === "ORCID");
const researchGateSocial = SOCIALS.find((s) => s.name === "ResearchGate");

const directEmail = "naim.molla.stats@gmail.com";
const gmailComposeUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${directEmail}`;
---

<BaseLayout title={PAGES.contact.title} description={PAGES.contact.subtitle}>
    <div class="container-narrow flex flex-col gap-8">
        <!-- Page Header -->
        <header class="page-header mb-0">
            <h1 class="page-title">{PAGES.contact.title}</h1>
            <p class="page-subtitle">
                {PAGES.contact.subtitle}
            </p>
        </header>

        <div class="grid gap-6 md:grid-cols-[1fr_18rem]">
            <!-- Left Column: Contact Form -->
            <article class="p-6 rounded-xl border border-[var(--border)] bg-[var(--surface)]">
                <h2 class="title-md font-bold mb-1">Send a message</h2>
                <p class="body-sm opacity-80 mb-6">
                    Feel free to reach out about research collaborations, graduate opportunities, or questions.
                </p>

                <form
                    id="contact-form"
                    class="flex flex-col gap-4"
                >
                    <div class="grid gap-4 sm:grid-cols-2">
                        <label class="flex flex-col gap-1.5">
                            <span class="text-xs font-semibold uppercase tracking-wider opacity-75">Name</span>
                            <input
                                type="text"
                                id="form-name"
                                name="name"
                                required
                                placeholder="Your name"
                                class="px-3.5 py-2.5 rounded-lg border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] text-sm focus:outline-none focus:border-[var(--accent)] transition-colors"
                            />
                        </label>

                        <label class="flex flex-col gap-1.5">
                            <span class="text-xs font-semibold uppercase tracking-wider opacity-75">Email</span>
                            <input
                                type="email"
                                id="form-email"
                                name="email"
                                required
                                placeholder="your.email@example.com"
                                class="px-3.5 py-2.5 rounded-lg border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] text-sm focus:outline-none focus:border-[var(--accent)] transition-colors"
                            />
                        </label>
                    </div>

                    <label class="flex flex-col gap-1.5">
                        <span class="text-xs font-semibold uppercase tracking-wider opacity-75">Subject</span>
                        <input
                            type="text"
                            id="form-subject"
                            name="subject"
                            required
                            placeholder="Research inquiry / Collaboration"
                            class="px-3.5 py-2.5 rounded-lg border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] text-sm focus:outline-none focus:border-[var(--accent)] transition-colors"
                        />
                    </label>

                    <label class="flex flex-col gap-1.5">
                        <span class="text-xs font-semibold uppercase tracking-wider opacity-75">Message</span>
                        <textarea
                            id="form-message"
                            name="message"
                            required
                            rows="5"
                            placeholder="Write your message here..."
                            class="px-3.5 py-2.5 rounded-lg border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] text-sm focus:outline-none focus:border-[var(--accent)] transition-colors resize-y"
                        ></textarea>
                    </label>

                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
                        <p class="text-xs opacity-70 mb-0">
                            I read everything; replies usually within a day or two.
                        </p>
                        <button
                            type="submit"
                            id="send-msg-btn"
                            class="btn btn-sm inline-flex items-center justify-center gap-2 font-semibold cursor-pointer"
                        >
                            <Icon name="Mail" size={16} />
                            <span>Send message</span>
                        </button>
                    </div>
                </form>
            </article>

            <!-- Right Column: Other Ways to Reach -->
            <article class="p-6 rounded-xl border border-[var(--border)] bg-[var(--surface)] h-fit">
                <h2 class="title-md font-bold mb-1">Other ways to reach me</h2>
                <p class="body-sm opacity-80 mb-4">
                    Prefer direct channels? Use any of these links.
                </p>

                <ul class="flex flex-col gap-3.5 pl-0 list-none mb-0">
                    <li>
                        <a
                            href={gmailComposeUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm font-semibold text-[var(--accent)] hover:underline flex items-center gap-2"
                        >
                            <Icon name="Mail" size={16} />
                            <span>Email directly</span>
                        </a>
                        <span class="block text-xs opacity-60 mt-0.5 ml-6">
                            {directEmail}
                        </span>
                    </li>

                    {linkedInSocial && (
                        <li>
                            <a
                                href={linkedInSocial.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-sm font-semibold text-[var(--foreground)] hover:text-[var(--accent)] hover:underline flex items-center gap-2"
                            >
                                <Icon name="LinkedIn" size={16} />
                                <span>LinkedIn</span>
                            </a>
                        </li>
                    )}

                    {scholarSocial && (
                        <li>
                            <a
                                href={scholarSocial.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-sm font-semibold text-[var(--foreground)] hover:text-[var(--accent)] hover:underline flex items-center gap-2"
                            >
                                <Icon name="GoogleScholar" size={16} />
                                <span>Google Scholar</span>
                            </a>
                        </li>
                    )}

                    {githubSocial && (
                        <li>
                            <a
                                href={githubSocial.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-sm font-semibold text-[var(--foreground)] hover:text-[var(--accent)] hover:underline flex items-center gap-2"
                            >
                                <Icon name="Github" size={16} />
                                <span>GitHub</span>
                            </a>
                        </li>
                    )}

                    {researchGateSocial && (
                        <li>
                            <a
                                href={researchGateSocial.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-sm font-semibold text-[var(--foreground)] hover:text-[var(--accent)] hover:underline flex items-center gap-2"
                            >
                                <Icon name="ResearchGate" size={16} />
                                <span>ResearchGate</span>
                            </a>
                        </li>
                    )}

                    {orcidSocial && (
                        <li>
                            <a
                                href={orcidSocial.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-sm font-semibold text-[var(--foreground)] hover:text-[var(--accent)] hover:underline flex items-center gap-2"
                            >
                                <Icon name="ORCID" size={16} />
                                <span>ORCID</span>
                            </a>
                        </li>
                    )}
                </ul>
            </article>
        </div>
    </div>
</BaseLayout>

<script is:inline>
    function setupContactForm() {
        const form = document.getElementById("contact-form");
        if (form) {
            form.addEventListener("submit", (e) => {
                e.preventDefault();
                const name = document.getElementById("form-name")?.value || "";
                const email = document.getElementById("form-email")?.value || "";
                const subject = document.getElementById("form-subject")?.value || "Research Inquiry";
                const message = document.getElementById("form-message")?.value || "";

                const bodyText = `From: ${name} (${email})\n\n${message}`;
                const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=naim.molla.stats@gmail.com&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyText)}`;

                const win = window.open(gmailUrl, "_blank");
                if (!win || win.closed || typeof win.closed === "undefined") {
                    window.location.href = gmailUrl;
                }
            });
        }
    }

    setupContactForm();
    document.addEventListener("astro:page-load", setupContactForm);
</script>
